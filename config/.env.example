# ============================================================
# Local AI - Configuration
# ============================================================
# Copy this file to: config\.env  (remove the .example part)
# Then edit as needed.
# The launcher reads this file automatically.
# ============================================================

# Performance profile to use on launch.
# Options: max-performance | balanced | safe-mode
# Default: max-performance (best speed, ~88% GPU usage)
PROFILE=max-performance

# Ports (change only if you have conflicts)
OLLAMA_PORT=11434
WEBUI_PORT=3000

# Models
PRIMARY_MODEL=qwen2.5:8b
BACKUP_MODEL=qwen2.5:3b

# Open automatically in browser after launch? (true/false)
AUTO_OPEN_BROWSER=true
