# ============================================================
# Profile: MAX PERFORMANCE  (DEFAULT)
# ============================================================
# Designed for: GTX 1070 Ti 8GB VRAM, 16GB RAM
# Model:        qwen3.5:9b (~6.6 GB weights at Q4_K_M)
# GPU Usage:    ~88% (all 36 layers offloaded to GPU)
# Context:      4096 tokens — safe default for 9B on 8GB VRAM
#               (6.6GB weights + ~0.6GB KV cache = ~7.2GB total)
# Speed:        ~18-25 tokens/sec
# CPU Threads:  10 of 12 (leaves 2 for Windows)
# Best for:     Daily use — best speed with stable memory usage
# NOTE:         Do NOT use 8192 context with this model on 8GB —
#               it will push ~7.8GB+ and risk crashes.
#               Use quality.env only if you have closed other apps.
# ============================================================

OLLAMA_NUM_CTX=4096
OLLAMA_NUM_GPU=36
OLLAMA_NUM_THREAD=10
OLLAMA_FLASH_ATTENTION=1
OLLAMA_MAX_LOADED_MODELS=1
