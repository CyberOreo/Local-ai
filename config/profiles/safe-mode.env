# ============================================================
# Profile: SAFE MODE  (Fallback)
# ============================================================
# Designed for: When system feels sluggish or VRAM is stressed
# Model:        qwen3.5:9b (~6.6 GB weights at Q4_K_M)
# GPU Usage:    Partial — 20 of 36 layers on GPU, rest on CPU
# Context:      1024 tokens — minimal KV cache footprint
# Speed:        ~10-15 tokens/sec (CPU layers slow things down)
# CPU Threads:  4 of 12
# Best for:     Emergency fallback if max-performance crashes
# Tip:          Switch to qwen3.5:4b in model selector instead —
#               it runs fully on GPU at ~40-50 tok/s
# ============================================================

OLLAMA_NUM_CTX=1024
OLLAMA_NUM_GPU=20
OLLAMA_NUM_THREAD=4
OLLAMA_MAX_LOADED_MODELS=1
