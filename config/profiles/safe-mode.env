# ============================================================
# Profile: SAFE MODE  (Fallback)
# ============================================================
# Designed for: When system feels sluggish or unstable
# GPU Usage:    ~50% (partial GPU offload)
# Context:      2048 tokens (~3.5GB VRAM — very comfortable)
# Speed:        ~15-20 tokens/sec on qwen3:8b
# CPU Threads:  4 of 12
# Best for:     When running heavy background apps simultaneously
#               or if max-performance causes crashes/slowdowns
# Tip:          Switch to backup model (qwen3:4b) for even
#               faster response in safe mode
# ============================================================

OLLAMA_NUM_CTX=2048
OLLAMA_NUM_GPU=20
OLLAMA_NUM_THREAD=4
OLLAMA_MAX_LOADED_MODELS=1
